# Copie para `.env` e preencha antes de iniciar o backend.

# Autenticacao e Criptografia (obrigatorias)
# JWT_SECRET: minimo 64 bytes/caracteres ASCII para HS512 (ex.: openssl rand -base64 48)
JWT_SECRET=
# TWO_FACTOR_ENCRYPTION_KEY: 32 bytes em Base64 / 44 chars (ex.: openssl rand -base64 32)
TWO_FACTOR_ENCRYPTION_KEY=

# Convites (obrigatorias)
# INVITATION_ENCRYPTION_KEY: 32 bytes em Base64 / 44 chars (ex.: openssl rand -base64 32)
INVITATION_ENCRYPTION_KEY=
INVITATION_FRONTEND_ORIGIN=http://localhost:5173

# Chaves de API dos Provedores (opcionais localmente)
AVENIA_API_KEY=
AVENIA_PRIVATE_KEY=

BLINDPAY_API_KEY=
BLINDPAY_INSTANCE_ID=
BLINDPAY_WEBHOOK_SECRET=

# Suporte IA (opcional localmente)
AI_SUPPORT_PROVIDER=gemini
AI_SUPPORT_API_KEY=
